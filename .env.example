# Veritabanı. Yerelde dosya; canlıda Turso adresi (libsql://...) ve token.
DATABASE_URL=file:./data/karasancak.db
# DATABASE_AUTH_TOKEN=

# Ziyaretçi özetleri için gizli anahtar. Canlıda zorunlu.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Sitenin kök adresi. Referans ve aktivasyon linkleri bu adresle üretilir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# İlk kurulumda oluşturulacak yönetici. Şifre boşsa üretilip konsola bir kez yazılır.
ADMIN_USERNAME=kagan
ADMIN_NAME=Sancak Yönetimi
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Yalnızca yerelde, npm run db:seed -- --demo ile yüklenen örnek üyelerin şifresi
DEMO_PASSWORD=
